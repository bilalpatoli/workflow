# --- Butterbase (web portal — public API URL) ---
# Browser-safe. RLS off for hackathon scope, no auth needed for reads/writes.
NEXT_PUBLIC_BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_xxxxx

# --- Butterbase service key (Kyle's pipeline only — NEVER expose to browser) ---
BUTTERBASE_SERVICE_KEY=bb_sk_xxxxx

# --- Z.AI (agents) ---
ZAI_API_KEY=

# --- Seedance (video generation) ---
# Swap to next key when BytePlus credits run out
SEEDANCE_API_KEY=

# ImaRouter (Seedance fallback when BytePlus credits exhausted)
IMAROUTER_API_KEY=

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=4000
